# Supabase Postgres Data API (server-only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public Supabase Storage bucket URL, no trailing slash.
# Example: https://project.supabase.co/storage/v1/object/public/meter-down-audio
AUDIO_PUBLIC_BASE_URL=

# Protects all catalog mutation endpoints. Generate at least 32 random bytes.
ADMIN_API_TOKEN=

# Optional metadata import credentials. These never provide playback audio.
SPOTIFY_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# Optional presence and rate limiting. Playback still works if Redis is down.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Flags SDK + Statsig (server-side evaluation)
FLAGS_SECRET=
STATSIG_SERVER_API_KEY=
STATSIG_PROJECT_ID=4LOpcBrud7gJvDgneRwmrc

# Optional Vercel Global Config sync for Statsig
EXPERIMENTATION_CONFIG=
EXPERIMENTATION_CONFIG_ITEM_KEY=

# Only needed if a browser-side Statsig SDK is added later.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
